#!/usr/bin/env python3
"""
AkerGate - Command Line & TUI Interface Entrypoint
"""

import sys
import os
from pathlib import Path

# Add project root to python path
project_root = Path(__file__).resolve().parent.parent
if str(project_root) not in sys.path:
    sys.path.insert(0, str(project_root))

from akergate.config import load_config, get_totp_secret_file
from akergate.core.storage import get_totp_secret, get_telegram_secret
from akergate.core.totp import compute_totp, build_otpauth_uri
from akergate.pam.patcher import is_pam_patched, patch_pam, unpatch_pam
from akergate.tui.qr_render import generate_terminal_qr
from akergate.tui.ascii_banner import print_banner
from akergate.tui.app import main_tui
from akergate.i18n import t, get_current_language, set_language, list_available_languages

def print_help():
    print(t("cli.help_header"))
    print(t("cli.usage"))
    print("")
    print(t("cli.commands"))
    print(f"  {t('cli.cmd_none')}")
    print(f"  {t('cli.cmd_status')}")
    print(f"  {t('cli.cmd_qr')}")
    print(f"  {t('cli.cmd_patch')}")
    print(f"  {t('cli.cmd_unpatch')}")
    print(f"  {t('cli.cmd_lockdown')}")
    print(f"  {t('cli.cmd_disarm')}")
    print(f"  {t('cli.cmd_report')}")
    print(f"  {t('cli.cmd_sentry')}")
    print(f"  {t('cli.cmd_banner')}")
    print(f"  lang [code] Switch or display language ({', '.join(list_available_languages())})")
    print(f"  {t('cli.cmd_help')}")

def main():
    if len(sys.argv) == 1:
        main_tui()
        return

    cmd = sys.argv[1].lower()

    if cmd in ("-h", "--help", "help"):
        print_help()
    elif cmd in ("banner", "logo", "about"):
        is_full = len(sys.argv) > 2 and sys.argv[2] in ("--full", "-f")
        print_banner(full=is_full)
    elif cmd == "lang":
        if len(sys.argv) > 2:
            new_l = sys.argv[2].lower()
            if set_language(new_l):
                print(f"[+] Language changed to: {new_l}")
            else:
                print(f"[!] Language '{new_l}' not found. Available: {list_available_languages()}")
        else:
            print(f"[i] Current language: {get_current_language()} (Available: {list_available_languages()})")
    elif cmd == "status":
        cfg = load_config()
        patched = is_pam_patched()
        totp_ok = bool(get_totp_secret())
        tg_ok = bool(get_telegram_secret())
        print(t("cli.status_pam", status='[ACTIVE]' if patched else '[NOT CONFIGURED]'))
        print(t("cli.status_totp", status='[YES]' if totp_ok else '[NO]'))
        print(t("cli.status_tg", status='[YES]' if tg_ok else '[NO]'))
    elif cmd == "qr":
        secret = get_totp_secret()
        if not secret:
            print("[!] No TOTP secret key found. Run 'akergate' to generate one.")
            sys.exit(1)
        user = os.environ.get("USER", "yuki")
        uri = build_otpauth_uri(secret, user)
        print(f"[i] Base32 Secret: {secret}\n")
        print(generate_terminal_qr(uri))
    elif cmd == "patch":
        if os.geteuid() != 0:
            print("[!] Root privileges required. Run: sudo akergate patch")
            sys.exit(1)
        ok, msg = patch_pam()
        print(f"[{'+' if ok else '!'}] {msg}")
    elif cmd == "unpatch":
        if os.geteuid() != 0:
            print("[!] Root privileges required. Run: sudo akergate unpatch")
            sys.exit(1)
        ok, msg = unpatch_pam()
        print(f"[{'+' if ok else '!'}] {msg}")
    elif cmd == "lockdown":
        from akergate.core.lockdown import trigger_lockdown
        policy = sys.argv[2] if len(sys.argv) > 2 else "dual_totp"
        ok, report = trigger_lockdown(policy_input=policy, trigger_source="cli_command")
        if ok:
            print(f"[+] Emergency lockdown activated with policy '{policy}'.")
            print(f"[+] Forensic snapshot created at: {report}")
        else:
            print(f"[!] Failed to trigger lockdown: {report}")
    elif cmd == "disarm":
        from akergate.core.lockdown import disarm_lockdown
        if disarm_lockdown():
            print("[+] Emergency lockdown disarmed. Flexible multi-auth restored.")
        else:
            print("[!] Failed to disarm lockdown.")
    elif cmd == "report":
        from akergate.core.lockdown import get_lockdown_state
        state = get_lockdown_state()
        rep_path = state.get("report_path")
        if rep_path and Path(rep_path).exists():
            print(Path(rep_path).read_text(encoding="utf-8"))
        else:
            print("[!] No incident report available.")
    elif cmd == "sentry":
        from akergate.sentry.daemon import run_sentry_daemon
        run_sentry_daemon()
    else:
        print(f"[!] Unknown command: {cmd}")
        print_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
